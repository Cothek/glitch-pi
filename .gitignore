node_modules/
plugins/mcp-server/node_modules/


# Security testing binaries (downloaded by bootstrap)
tools/security/*.exe
tools/security/*.tar.gz
tools/security/*.zip

# Moved to data/ (2026-08-08) — historical UI mockups, security reports
/samples/
/reports/

# Runtime data directory (config backups, node bundle, model cache, screenshots)
data/

# Personal user profile (created per-installation, NOT shared via git)
user/

# Generated skill runtime trees (synced from engine at launch — Plan 2 §12.3 Phase B)
# Source of truth: glitch-memorycore/plugins/glitch-skills/skills/ (65 skills)
.agents/skills/
.pi/skills/

# Handy voice input (downloaded third-party binary)
handy-voice/

cloudflared.exe.tmp
# Large binary backups
*.exe.old.*
opencode/opencode.exe.old.*

# Root-level one-shot debug scripts (prevent re-committing junk)
/check-*.js
/fix.js
/test-*.cjs
/test-*.mjs
/verify-*.mjs
/verify-*.ps1
/query
/README.html

# Quarantine dir (redundant with data/ above, explicit for documentation)
data/quarantine/

# Pi session scratch (glitch-pi local)
.pi-tmp/

# Generated by `gitnexus analyze` for Claude Code, which this repo does not use
# (pi reads AGENTS.md). It reappears on disk after a changed-index run - expected.
CLAUDE.md

