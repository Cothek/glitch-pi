    service: http://localhost:4103

  # Glitch Trader frontend
  - hostname: glitch-trader.cothekdesigns.com
    service: http://localhost:3000

  # Glitch Trader API
  - hostname: glitch-trader-api.cothekdesigns.com
    service: http://localhost:4120

  # Pi web UI alias - same auth-proxy as glitch.cotekdesigns.com
  - hostname: pi.cotekdesigns.com
    service: http://localhost:4103

  # Tower Audio Recorder (auth-protected on :8721). NOTE the spelling: this ONE
  # hostname is audio-recorder.cotekhdesigns.com WITH an h, unlike every other
  # hostname in this file. Do not "fix" it to match the others.
  - hostname: audio-recorder.cotekhdesigns.com
    service: http://127.0.0.1:8721

  # Catch-all: return 404 for any other hostname
  # MUST stay last: cloudflared matches ingress rules top-down and stops at the
  # first hit. A catch-all above a hostname rule would shadow it.
  - service: http_status:404
